Test_df = pd.DataFrame(Test_list)





#Calculate distance to a closest city, railway, highway, etc.
for index, record in Test_df.iterrows():
    for i in range(len(launch_sites_df)):
        if record['Launch Site'] == launch_sites_df.loc[i,'Launch Site']:
            compare_lat = launch_sites_df.loc[index,'Lat']
            compare_long = launch_sites_df.loc[index,'Long']
    Test_df.loc[index,'Test_distance'] = calculate_distance(compare_lat, compare_long, record['Test_lat'], record['Test_long'])

Test_df






# Create a marker with distance to a closest city, railway, highway, etc.
for index, record in Test_df.iterrows():    
    distance_marker=folium.Marker(location=[record['Test_lat'],record['Test_long']],
                                  icon=DivIcon(
                                      icon_size=(20,20),
                                      icon_anchor=(0,0),
                                      html= '<div style="font-size: 12; color:#d35400;"><b>%s</b></div>' % "{:10.2f} KM".format(record['Test_distance']),
                                  )
                                 )
    #Create folium.PolyLine objects using the coastline coordinates and launch site coordiantes
    if record['Test_location'] = 'Railway':
        TLine_color = 'red'
    elif record['Test_location'] = 'Highway': 
        TLine_color = 'purple'
    else record['Test_location'] = 'City':
        TLine_color = 'green'
    lines = folium.PolyLine(locations=[(record['Test_lat'],record['Test_long']),(record['Test_lat'],record['Test_long'])], color= TLine_color, weight=1)
    #Add the distance marker and lines to the map
    site_map.add_child(distance_marker)
    site_map.add_child(lines)


# Save updated map with all markers and line
site_map.save('SpaceX_map_with all markers.html')

