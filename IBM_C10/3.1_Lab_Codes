Task 3  Mark coastline points, find coordinates and calculate distance to launch sites
======================================================================================

#Create a dataframe to store the geospatial data for proximity to the launch sites
proximity_df = launch_sites_df
proximity_df['coastline_lat']= [28.5623, 28.56319, 28.59017, 34.63466]
proximity_df['coastline_lon']= [-80.56783, -80.56797, -80.61905, -120.62531]

proximity_df['distance_coastline'] = None

for index, record in proximity_df.iterrows():
    proximity_df.loc[index,'distance_coastline'] = calculate_distance(record['Lat'], record['Long'],record['coastline_lat'], record['coastline_lon'])

proximity_df

Task 3-[x] Draw Distance Markers and PolyLines to closest coastline points
===========================================================================

for index, record in proximity_df.iterrows():
    # Create and add a folium.Marker on your selected closest coastline points on the map and display the distance
    distance_marker=folium.Marker(location=[record['coastline_lat'],record['coastline_lon']],
                                  icon=DivIcon(
                                      icon_size=(20,20),
                                      icon_anchor=(0,0),
                                      html='<div style="font-size: 12; color:#d35400;"><b>%s</b></div>' % "{:10.2f} KM".format(record['distance_coastline']),
                                  )
                                 )
    
    #Create folium.PolyLine objects using the coastline coordinates and launch site coordiantes
    lines = folium.PolyLine(locations=[(record['coastline_lat'],record['coastline_lon']),(record['Lat'],record['Long'])], color='blue',weight=1)
    #Add the distance marker and lines to the map
    site_map.add_child(distance_marker)
    site_map.add_child(lines)
#export the resulting map to html file
site_map.save('site_map_with_distance markers.html')

